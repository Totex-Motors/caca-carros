generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WantedCarStatus {
  PENDING
  FOUND
  BOUGHT
  ARCHIVED
}

enum WantedCarCondition {
  NEW
  USED
}

enum WantedCarSellerType {
  PRIVATE
  PROFESSIONAL
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model WantedCar {
  id        String          @id @default(uuid())
  brand     String
  model     String
  version   String?         @map("version")
  clientName String?       @map("client_name")
  clientPhone String?      @map("client_phone")
  seller     String?       
  sellerType WantedCarSellerType? @map("seller_type")
  state      String?       // UF da busca (ex.: "SP"); null = padrao dos portais
  city       String?       // cidade da busca; null = estado inteiro
  condition WantedCarCondition? @map("condition")
  yearFrom  Int             @map("year")
  yearTo    Int?            @map("year_to")
  mileageFrom Int?          @map("mileage_from")
  mileageTo Int?            @map("mileage_to")
  maxPrice  Int             @map("max_price")
  status    WantedCarStatus @default(PENDING)
  createdAt DateTime        @default(now()) @map("created_at")

  cars Car[]

  @@map("wanted_cars")
}

model Car {
  id          String   @id @default(uuid())
  brand       String
  model       String
  title       String?
  year        Int
  price       Int
  mileage     Int?
  fuel        String?
  transmission String?
  city        String?
  state       String?
  photos      String[] @default([])
  url         String
  image       String?
  portal      String?
  createdAt   DateTime @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")
  wantedCarId String   @map("wanted_car_id")
  wantedCar   WantedCar @relation(fields: [wantedCarId], references: [id], onDelete: Cascade)

  @@unique([wantedCarId, url])
  @@index([wantedCarId])
  @@index([createdAt])
  @@map("cars")
}

// Dossie tecnico de um modelo/ano gerado pela IA (AutoExpert). Um por slug, reaproveitado entre consultas.
model Dossie {
  id        String   @id @default(uuid())
  slug      String   @unique
  consulta  String
  marca     String
  modelo    String
  ano       Int
  modeloIa  String   @map("modelo_ia")
  dados     Json
  fipe      Json?
  createdAt DateTime @default(now()) @map("created_at")

  aliases DossieAlias[]

  @@index([createdAt])
  @@map("dossies")
}

// Outras grafias da mesma busca ("compass 2018", "jeep compass 2018") apontando para o mesmo dossie.
model DossieAlias {
  alias    String @id
  dossieId String @map("dossie_id")
  dossie   Dossie @relation(fields: [dossieId], references: [id], onDelete: Cascade)

  @@map("dossie_aliases")
}

// Analise de um anuncio especifico (link ou texto + fotos enviados pelo usuario).
model AnaliseAnuncio {
  id        String   @id @default(uuid())
  url       String?
  dados     Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([url])
  @@map("analises_anuncio")
}
