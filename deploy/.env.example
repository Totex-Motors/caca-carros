# Copie para deploy/.env (o install.sh faz isso por voce).

# Subdominio onde o app vai rodar
DOMAIN=carros.grupocardoso.online

# Login do app (criado na primeira vez que o servidor sobe)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Gerados automaticamente pelo install.sh
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Buscas
EXTERNAL_SEARCH_ENABLED=true
CAR_SEARCH_CRON=0 */6 * * *
CAR_CLEANUP_CRON=0 3 * * *
CAR_RETENTION_DAYS=30

# Apify / Webmotors (opcional)
APIFY_TOKEN=
APIFY_ACTOR_ID=ribtools/webmotors-scraper
APIFY_TIMEOUT_MS=180000

# Proxy da OLX (opcional)
PROXY_HOST=br.decodo.com
PROXY_PORT=
PROXY_PORTS=
PROXY_USER=
PROXY_PASS=
OLX_ADS_LIMIT=10
OLX_MAX_PAGES=1
OLX_RETRY_ATTEMPTS=2
OLX_NAV_TIMEOUT_MS=90000
OLX_SEARCH_TIMEOUT_MS=180000
